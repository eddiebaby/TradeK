# Device-specific environment variables for laptop
DEVICE_NAME=laptop
DEVICE_TYPE=development

# LLMLingua Configuration
LLMLINGUA_PORT=8765
LLMLINGUA_HOST=localhost
LLMLINGUA_CACHE_DIR=/home/scottschweizer/TradeKnowledge/.cache/llmlingua
LLMLINGUA_LOG_LEVEL=INFO

# Claude Code Configuration
CLAUDE_CODE_DEVICE=laptop
CLAUDE_CODE_WORKSPACE=/home/scottschweizer/TradeKnowledge

# Service Configuration
AUTO_START_SERVICES=true
LLMLINGUA_AUTO_START=true

# Development Settings
DEBUG=true
LOG_LEVEL=DEBUG
ENABLE_HOT_RELOAD=true

# Performance Settings (laptop-optimized)
MAX_WORKERS=2
COMPRESSION_TIMEOUT=30
CACHE_SIZE=100MB

# Directory Paths
LOGS_DIR=/home/scottschweizer/.claude/logs
CONFIG_DIR=/home/scottschweizer/.claude
DATA_DIR=/home/scottschweizer/TradeKnowledge/data

# Git Configuration
GIT_BRANCH=laptop-dev
GIT_REMOTE=origin