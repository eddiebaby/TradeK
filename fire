              default='fastapi', 
              help='Technology stack for implementation')
@click.option('--deploy', 
              type=click.Choice(['docker', 'k8s', 'serverless', 'bare-metal']),
              default='docker', 
              help='Deployment target')
@click.option('--quality', 
              type=click.Choice(['development', 'staging', 'production']),
              default='production', 
              help='Quality level and gates to apply')
@click.option('--interactive', is_flag=True, help='Interactive mode with guided prompts')
@click.option('--status', is_flag=True, help='Show SPARC trio status')
@click.option('--health-check', is_flag=True, help='Run comprehensive health check')
@click.option('--config', type=click.Path(exists=True), help='Configuration file path')
@click.option('--output', type=click.Path(), help='Output directory for generated artifacts')
def main(task, stack, deploy, quality, interactive, status, health_check, config, output):
    """
    🔥 FIRE - Production-Ready SPARC Trio Command
    
    Activate the SPARC trio agents for intelligent development workflows.
    
    Examples:
      ./fire "build trading API with authentication"
      ./fire --task "implement ML pipeline" --stack pytorch --deploy k8s
      ./fire --interactive
      ./fire --status
      ./fire --health-check
    """
    
    fire_cmd = FireCommand()
    
    async def run_fire():
        nonlocal status, health_check, interactive, task, stack, deploy, quality, config, output
        
        if status:
            print("🔥 FIRE Command - SPARC Trio Status")
            print("=" * 50)
            validation = await fire_cmd.validate_environment()
            
            print(f"\n📊 Overall Status: {validation['status']}")
            print(f"🆔 Session ID: {fire_cmd.session_id}")
            
            print(f"\n🌍 Environment Variables:")
            for var, status in validation['environment'].items():
                print(f"  {var}: {status}")
            
            print(f"\n🤖 SPARC Trio Agents:")
            for agent, status in validation['trio_agents'].items():
                print(f"  {agent.upper()}: {status}")
                
            print(f"\n🔧 Dependencies:")
            for dep, status in validation['dependencies'].items():
                status_icon = "✅" if status else "❌"
                print(f"  {dep}: {status_icon}")
                
            return
        
        if health_check:
            print("🔥 FIRE Command - Health Check")
            print("=" * 50)
            
            print("\n🔍 Running comprehensive health check...")
            validation = await fire_cmd.validate_environment()
            
            print(f"\n📋 Health Check Results:")
            print(f"Status: {validation['status']}")
            print(f"Timestamp: {validation['timestamp']}")
            
            if validation['status'] == "✅ PRODUCTION_READY":
                print("\n🎉 All systems ready for production workloads!")
            elif validation['status'] == "⚠️  DEVELOPMENT_READY":
                print("\n⚠️  Ready for development, some production features may be limited.")
            else:
                print("\n❌ System not ready. Please check configuration.")
                
            # Run MCP health check if available
            mcp_script = fire_cmd.project_root / "check_mcp_health.sh"
            if mcp_script.exists():
                print("\n🔌 Running MCP Server Health Check...")
                import subprocess
                try:
                    result = subprocess.run([str(mcp_script)], 
                                          capture_output=True, text=True, cwd=fire_cmd.project_root)
                    if result.returncode == 0:
                        print("✅ MCP servers are healthy")
                    else:
                        print("⚠️  Some MCP servers may need attention")
                except Exception as e:
                    print(f"⚠️  Could not run MCP health check: {e}")
            
            return
        
        if interactive:
            print("🔥 FIRE Command - Interactive Mode")
            print("=" * 50)
            
            print("\nWelcome to the SPARC Trio Interactive Command Interface!")
            print("\nThe trio consists of:")
            print("🔍 RESEARCHER - Intelligence synthesis and analysis")
            print("🧠 MASTERMIND - Strategic architecture and planning")
            print("⚡ EXECUTOR - Implementation virtuosity and testing")
            
            if not task:
                task = click.prompt("\n📝 What would you like the SPARC trio to build?")
            
            stack = click.prompt(
                f"\n🏗️  Technology stack", 
                default=stack,
                type=click.Choice(['fastapi', 'django', 'flask', 'pytorch', 'tensorflow', 'react', 'vue', 'nextjs'])
            )
            
            deploy = click.prompt(
                f"\n🚀 Deployment target", 
                default=deploy,
                type=click.Choice(['docker', 'k8s', 'serverless', 'bare-metal'])
            )
            
            quality = click.prompt(
                f"\n⭐ Quality level", 
                default=quality,
                type=click.Choice(['development', 'staging', 'production'])
            )
            
            print(f"\n🎯 Configuration Summary:")
            print(f"Task: {task}")
            print(f"Stack: {stack}")
            print(f"Deploy: {deploy}")
            print(f"Quality: {quality}")
            
            if click.confirm("\nProceed with FIRE execution?"):
                result = await fire_cmd.execute_fire_task(
                    task, stack=stack, deploy=deploy, quality=quality, interactive=True
                )
                
                if result['status'] == 'success':
                    print(f"\n🎉 Task completed successfully!")
                    if output:
                        output_file = Path(output) / f"fire_result_{fire_cmd.session_id}.json"
                        output_file.parent.mkdir(parents=True, exist_ok=True)
                        with open(output_file, 'w') as f:
                            json.dump(result, f, indent=2)
                        print(f"📄 Results saved to: {output_file}")
                else:
                    print(f"\n❌ Task failed: {result.get('error', 'Unknown error')}")
            else:
                print("🚫 FIRE execution cancelled")
            
            return
        
        if not task:
            print("🔥 FIRE Command")
            print("=" * 50)
            print("Error: Task required.")
            print("\nUsage:")
            print("  ./fire 'build trading API with authentication'")
            print("  ./fire --interactive")
            print("  ./fire --status")
            print("  ./fire --help")
            return
        
        # Execute the fire task
        result = await fire_cmd.execute_fire_task(
            task, stack=stack, deploy=deploy, quality=quality
        )
        
        if output:
            output_file = Path(output) / f"fire_result_{fire_cmd.session_id}.json"
            output_file.parent.mkdir(parents=True, exist_ok=True)
            with open(output_file, 'w') as f:
                json.dump(result, f, indent=2)
            print(f"\n📄 Results saved to: {output_file}")
    
    # Run the async function
    asyncio.run(run_fire())

if __name__ == '__main__':
    main()