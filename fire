    async def validate_environment(self) -> Dict[str, Any]:
        """Validate production environment readiness."""
        validation = {
            "timestamp": datetime.utcnow().isoformat(),
            "session_id": self.session_id,
            "environment": {},
            "dependencies": {},
            "trio_agents": {},
            "quality_gates": {},
            "status": "unknown"
        }
        
        try:
            # Check environment variables
            env_vars = [
                "GEMINI_API_KEY", "PERPLEXITY_API_KEY", "GITHUB_PERSONAL_ACCESS_TOKEN",
                "OPENAI_API_KEY", "ANTHROPIC_API_KEY"
            ]
            
            validation["environment"] = {
                var: "✅ SET" if os.getenv(var) else "❌ MISSING"
                for var in env_vars
            }
            
            # Check agent directories
            agent_dirs = ["researcher", "mastermind", "executor"]
            validation["trio_agents"] = {
                agent: "✅ READY" if (self.project_root / "agents" / agent).exists() 
                       else "❌ MISSING"
                for agent in agent_dirs
            }
            
            # Check dependencies
            deps_check = await self._check_dependencies()
            validation["dependencies"] = deps_check
            
            # Overall status
            env_ready = all("✅" in status for status in validation["environment"].values())
            agents_ready = all("✅" in status for status in validation["trio_agents"].values())
            deps_ready = all(deps_check.values())
            
            if env_ready and agents_ready and deps_ready:
                validation["status"] = "✅ PRODUCTION_READY"
            elif agents_ready:
                validation["status"] = "⚠️  DEVELOPMENT_READY"
            else:
                validation["status"] = "❌ NOT_READY"
                
        except Exception as e:
            validation["status"] = f"❌ ERROR: {str(e)}"
            
        return validation
    
