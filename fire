    def _assess_task_complexity(self, task: str, research_results: Dict, strategic_results: Dict) -> str:
        """Assess task complexity based on real agent analysis."""
        
        # Extract complexity indicators from agent responses
        task_lower = task.lower()
        
        # Check research complexity indicators
        research_complexity_score = 0
        if research_results.get("research_intelligence", {}).get("insights"):
            insight_count = len(research_results["research_intelligence"]["insights"])
            research_complexity_score = min(insight_count / 10, 1.0)  # Normalize to 0-1
        
        # Check strategic complexity indicators  
        strategic_complexity_score = 0
        if strategic_results.get("complexity_assessment"):
            strategic_complexity_score = strategic_results["complexity_assessment"].get("complexity_score", 0.5)
        
        # Keyword-based complexity assessment
        complexity_keywords = {
            "simple": ["hello", "basic", "simple", "quick"],
            "moderate": ["api", "service", "integration", "dashboard"], 
            "complex": ["machine learning", "ai", "distributed", "microservices", "blockchain"],
            "enterprise": ["enterprise", "scalable", "production", "compliance", "security"]
        }
        
        keyword_complexity = "moderate"
        for level, keywords in complexity_keywords.items():
            if any(keyword in task_lower for keyword in keywords):
                keyword_complexity = level
                break
        
        # Combine all complexity indicators
        combined_score = (research_complexity_score + strategic_complexity_score) / 2
        
        if combined_score > 0.8 or keyword_complexity == "enterprise":
            return "enterprise"
        elif combined_score > 0.6 or keyword_complexity == "complex":
            return "complex"
        elif combined_score > 0.4 or keyword_complexity == "moderate":
            return "moderate"
        else:
            return "simple"

