# OpenAI API Key (for embeddings)
OPENAI_API_KEY=your_key_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_key_here

# Github Personal Access Token (also used for MCP GitHub server)
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here
GITHUB_TOOLSETS=repository,issues,pull_requests
GITHUB_READ_ONLY=true

# MCP Server Configuration
# Perplexity API for research and analysis
PERPLEXITY_API_KEY=your_perplexity_key_here
PERPLEXITY_MODEL=sonar-deep-research

# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_key_here

# Database Configuration
# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tradeknowledge
POSTGRES_USER=tradeknowledge_app
POSTGRES_PASSWORD=tradeknowledge_secure_password_2024

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50

# InfluxDB (update with your actual values)
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=blackboard-super-secret-auth-token
INFLUX_ORG=tradeknowledge
INFLUX_BUCKET=market_data

# Connection pooling
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=30

# Database URLs for easy connection
DATABASE_URL=postgresql://tradeknowledge_app:tradeknowledge_secure_password_2024@localhost:5432/tradeknowledge

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/tradeknowledge.log

# Development
DEBUG=true
TESTING=false