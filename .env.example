# OpenAI API Key (for embeddings)
OPENAI_API_KEY=your_key_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_key_here

# Github Personal Access Token (also used for MCP GitHub server)
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here
GITHUB_TOOLSETS=repository,issues,pull_requests
GITHUB_READ_ONLY=true

# MCP Server Configuration
# Perplexity API for research and analysis
PERPLEXITY_API_KEY=your_perplexity_key_here
PERPLEXITY_MODEL=sonar-deep-research

# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_key_here

# Database Configuration
# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tradeknowledge
POSTGRES_USER=tradeknowledge_app
POSTGRES_PASSWORD=tradeknowledge_secure_password_2024

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50

# =============================================================================
# INFLUXDB CONFIGURATION (Primary Time-Series Database)
# =============================================================================
# Docker container settings (automatically configured)
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_ORG=tradeknowledge
INFLUXDB_BUCKET=market_data

# Authentication (use strong credentials in production)
INFLUXDB_ADMIN_USERNAME=admin
INFLUXDB_ADMIN_PASSWORD=tradeknowledge123
INFLUXDB_ADMIN_TOKEN=tradeknowledge-super-secret-token

# Performance tuning
INFLUXDB_TIMEOUT=30
INFLUXDB_BATCH_SIZE=10000
INFLUXDB_MAX_RETRIES=3
INFLUXDB_ENABLE_GZIP=true
INFLUXDB_RETENTION=0s

# Legacy InfluxDB settings (for backward compatibility)
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=blackboard-super-secret-auth-token
INFLUX_ORG=tradeknowledge
INFLUX_BUCKET=market_data

# =============================================================================
# MARKET DATA API KEYS
# =============================================================================

# Polygon.io (Primary equity and futures data)
# Sign up at https://polygon.io/ (free tier available)
POLYGON_API_KEY=your_polygon_api_key_here

# Alpha Vantage (Backup equity data source)
# Sign up at https://www.alphavantage.co/
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# Kraken (Crypto data source)
# Sign up at https://www.kraken.com/
KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_SECRET=your_kraken_secret_here

# Coinbase Pro (Additional crypto data source)
# Sign up at https://pro.coinbase.com/
COINBASE_API_KEY=your_coinbase_api_key_here
COINBASE_SECRET=your_coinbase_secret_here
COINBASE_PASSPHRASE=your_coinbase_passphrase_here

# =============================================================================
# AWS BEDROCK CONFIGURATION (Cost Optimization)
# =============================================================================
# For 47% cost reduction in ML processing
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1

# =============================================================================
# RATE LIMITING
# =============================================================================
# API rate limits (calls per minute)
EQUITY_RATE_LIMIT=5
CRYPTO_RATE_LIMIT=10

# Connection pooling
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=30

# Database URLs for easy connection
DATABASE_URL=postgresql://tradeknowledge_app:tradeknowledge_secure_password_2024@localhost:5432/tradeknowledge

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/tradeknowledge.log

# Development
DEBUG=true
TESTING=false