# Device-specific environment variables for desktop
DEVICE_NAME=desktop
DEVICE_TYPE=development

# LLMLingua Configuration
LLMLINGUA_PORT=8766
LLMLINGUA_HOST=localhost
LLMLINGUA_CACHE_DIR=/home/scott/Desktop/TradeKnowledge/.cache/llmlingua
LLMLINGUA_LOG_LEVEL=INFO

# Claude Code Configuration
CLAUDE_CODE_DEVICE=desktop
CLAUDE_CODE_WORKSPACE=/home/scott/Desktop/TradeKnowledge

# Service Configuration
AUTO_START_SERVICES=true
LLMLINGUA_AUTO_START=true

# Development Settings
DEBUG=true
LOG_LEVEL=DEBUG
ENABLE_HOT_RELOAD=true

# Performance Settings (desktop-optimized)
MAX_WORKERS=4
COMPRESSION_TIMEOUT=60
CACHE_SIZE=500MB

# Directory Paths
LOGS_DIR=/home/scott/.claude/logs
CONFIG_DIR=/home/scott/.claude
DATA_DIR=/home/scott/Desktop/TradeKnowledge/data

# Git Configuration
GIT_BRANCH=desktop-dev
GIT_REMOTE=origin