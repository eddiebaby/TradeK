## ============================================================================
## DESKTOP CONFIGURATION ADAPTATIONS
## ============================================================================

[PATH_ADAPTATIONS]
# Replace laptop paths with desktop paths in the following files:
FILES_REQUIRING_PATH_UPDATE:
- .env.desktop
- startup_services.sh
- superclaude_sync.py (config section)

LAPTOP_PATH_PATTERN=/home/scottschweizer
DESKTOP_PATH_REPLACEMENT=/home/scott

LAPTOP_WORKSPACE=/home/scottschweizer/TradeKnowledge
DESKTOP_WORKSPACE=/home/scott/Desktop/TradeKnowledge

[PORT_CONFIGURATIONS]
# Desktop uses different ports to avoid conflicts
LAPTOP_LLMLINGUA_PORT=8765
DESKTOP_LLMLINGUA_PORT=8766

LAPTOP_FASTAPI_PORT=8000
DESKTOP_FASTAPI_PORT=8001

[DEVICE_SPECIFIC_SETTINGS]
# Desktop-optimized performance settings
MAX_WORKERS=4  # Desktop has more resources
COMPRESSION_TIMEOUT=60  # Longer timeout for desktop
CACHE_SIZE=500MB  # Larger cache on desktop

## ============================================================================
## IMPLEMENTATION STEPS
## ============================================================================

[STEP_1_GIT_SETUP]
# Ensure clean git state
git status
git stash  # If there are uncommitted changes

# Pull latest changes from laptop
git checkout main
git pull origin main
git pull origin laptop-dev

# Create desktop branch
git checkout -b desktop-dev
git push -u origin desktop-dev

[STEP_2_DIRECTORY_SETUP]
# Create required directories
mkdir -p ${DESKTOP_WORKSPACE}/src/core
mkdir -p ${DESKTOP_WORKSPACE}/src/integrations
mkdir -p ${DESKTOP_WORKSPACE}/fastapi_auth
mkdir -p ${DESKTOP_WORKSPACE}/agents/{executor,mastermind,researcher}
mkdir -p ${CLAUDE_CONFIG_DIR}/logs

[STEP_3_FILE_TRANSFER]
# Copy files according to manifest
# Use rsync or scp from laptop to desktop
rsync -av --progress laptop_user@laptop_ip:/home/scottschweizer/TradeKnowledge/ ${DESKTOP_WORKSPACE}/
rsync -av --progress laptop_user@laptop_ip:/home/scottschweizer/.claude/ ${CLAUDE_CONFIG_DIR}/

[STEP_4_PATH_ADAPTATION]
# Update paths in configuration files
sed -i 's|/home/scottschweizer|/home/scott|g' ${DESKTOP_WORKSPACE}/.env.desktop
sed -i 's|/home/scottschweizer|/home/scott|g' ${CLAUDE_CONFIG_DIR}/startup_services.sh
sed -i 's|8765|8766|g' ${DESKTOP_WORKSPACE}/.env.desktop

[STEP_5_PERMISSIONS]
# Set correct permissions
chmod +x ${CLAUDE_CONFIG_DIR}/startup_services.sh
chmod +x ${DESKTOP_WORKSPACE}/src/core/llmlingua_service_runner.py
chmod +x ${DESKTOP_WORKSPACE}/src/integrations/superclaude_sync.py

[STEP_6_ENVIRONMENT_SETUP]
# Create desktop environment file
cp ${DESKTOP_WORKSPACE}/.env.desktop ${DESKTOP_WORKSPACE}/.env

# Install dependencies
cd ${DESKTOP_WORKSPACE}
pip install -r requirements.txt
cd fastapi_auth && pip install -r requirements.txt

[STEP_7_GIT_CONFIGURATION]
# Configure git for desktop
git config --local branch.desktop-dev.device desktop
git config --local alias.sync-main '!git checkout main && git pull origin main'
git config --local alias.sync-desktop '!git checkout desktop-dev && git merge main'

[STEP_8_SERVICE_INITIALIZATION]
# Test LLMLingua service
python -m src.core.llmlingua_service_runner --test

# Test SuperClaude integration
python -m src.integrations.superclaude_sync --setup
python -m src.integrations.superclaude_sync --test

