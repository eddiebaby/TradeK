CLAUDE_CONFIG_DIR=/home/scott/.claude

## ============================================================================
## ENVIRONMENT SETUP
## ============================================================================

# Step 1: Update Claude configuration directory
[ENV_SETUP]
mkdir -p ${CLAUDE_CONFIG_DIR}
mkdir -p ${CLAUDE_CONFIG_DIR}/logs

# Step 2: Set desktop environment variables
export DEVICE_NAME=desktop
export DEVICE_TYPE=development
export LLMLINGUA_PORT=8766
export LLMLINGUA_HOST=localhost

