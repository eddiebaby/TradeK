[VERIFICATION_COMMANDS]
# Test LLMLingua auto-start
${CLAUDE_CONFIG_DIR}/startup_services.sh

# Verify LLMLingua service
curl http://localhost:8766/health

# Test SuperClaude integration
python -m src.integrations.superclaude_sync --health

# Test FastAPI authentication
cd fastapi_auth && python -c "from app.main import app; print('FastAPI imports successfully')"

# Test agent configurations
ls agents/*/CLAUDE_ENHANCED.md

# Verify git configuration
git config --list | grep desktop

[SERVICE_ENDPOINTS]
LLMLingua Service: http://localhost:8766
LLMLingua Health: http://localhost:8766/health
LLMLingua Test: http://localhost:8766/test
FastAPI Auth: http://localhost:8001 (when running)

## ============================================================================
## ROLLBACK PROCEDURES
## ============================================================================

[ROLLBACK_COMMANDS]
# If implementation fails, rollback to previous state
git checkout main
git branch -D desktop-dev
rm -rf ${DESKTOP_WORKSPACE}/fastapi_auth
rm -rf ${DESKTOP_WORKSPACE}/src/integrations
rm ${CLAUDE_CONFIG_DIR}/startup_services.sh

[BACKUP_RECOMMENDATIONS]
# Before implementation, backup:
cp -r ${DESKTOP_WORKSPACE} ${DESKTOP_WORKSPACE}.backup
cp -r ${CLAUDE_CONFIG_DIR} ${CLAUDE_CONFIG_DIR}.backup

